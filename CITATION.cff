references:
  - type: legal-case
    title: "United States v. Dotterweich, 320 U.S. 277 (1943)"
    year: 1943
    authors:
      - name: "Supreme Court of the United States"
    notes: "The responsible-relation standard the Act applies."
  - type: legal-case
    title: "United States v. Park, 421 U.S. 658 (1975)"
    year: 1975
    authors:
      - name: "Supreme Court of the United States"
    notes: "Authority to prevent or correct; delegation is no defence."
  - type: legal-case
    title: "United States v. DeCoster, 828 F.3d 626 (8th Cir. 2016)"
    year: 2016
    authors:
      - name: "United States Court of Appeals for the Eighth Circuit"
    notes: "The culpability floor: no imprisonment without proven fault."
